{
  "manifest_version": 3,
  "name": "ScopeLens — Web Security & Network Intelligence Platform (Deep Capture)",
  "short_name": "ScopeLens",
  "version": "2.0.0",
  "description": "Deep capture edition with connection-level remote IP, observed ports, and TLS handshake intelligence via Chrome DevTools Protocol.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ScopeLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "devtools_page": "devtools.html"
}
